datasource db {
  provider = "postgresql"
  url      = env("AI_DATABASE_URL")
  directUrl = env("AI_DATABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -----------------------------------------------------------------------------
// 1. Core Financial & Credit Models
// -----------------------------------------------------------------------------

model CollegeAIWallet {
  id              String   @id @default(uuid())
  collegeId       String   @unique
  balance         BigInt   @default(0) // Available credits (1 credit = $0.000001 USD)
  reservedBalance BigInt   @default(0) // Credits locked for in-flight requests
  totalAllocated  BigInt   @default(0) // Lifetime granted credits
  totalConsumed   BigInt   @default(0) // Lifetime settled credits
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, FROZEN
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grants          AICreditGrant[]
  ledgerEntries   AICreditLedgerEntry[]

  @@index([status])
}

model AICreditGrant {
  id                String    @id @default(uuid())
  walletId          String
  collegeId         String
  source            String    // SUBSCRIPTION, PURCHASED, COMPLIMENTARY, MANUAL_ADJUSTMENT
  originalAmount    BigInt
  remainingAmount   BigInt
  purchaseRequestId String?   @unique
  billingCycle      String?   // E.g., "2026-11" for monthly plan allocations
  expiresAt         DateTime? // NULL for non-expiring purchased credits; cycle end for plan credits
  reason            String?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wallet            CollegeAIWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  ledgerEntries     AICreditLedgerEntry[]

  @@index([collegeId, expiresAt])
  @@index([walletId, remainingAmount])
}

model AICreditLedgerEntry {
  id              String   @id @default(uuid())
  collegeId       String
  walletId        String
  grantId         String?
  requestId       String?  // Reference to AIRequestLog.requestId
  type            String   // GRANT, RESERVE, SETTLE, RELEASE, REFUND, EXPIRY_FORFEIT, MANUAL_ADJUSTMENT
  amount          BigInt   // Positive for credit additions, negative for debits
  balanceAfter    BigInt   // Wallet balance after this transaction
  description     String
  metadata        Json?    // Contextual snapshots (pricing rates, models, reasons)
  createdAt       DateTime @default(now())

  wallet          CollegeAIWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  grant           AICreditGrant?  @relation(fields: [grantId], references: [id])

  @@index([collegeId, createdAt])
  @@index([walletId, createdAt])
  @@index([requestId])
}

// -----------------------------------------------------------------------------
// 2. Add-on Purchases & Financial Lifecycle
// -----------------------------------------------------------------------------

model AIAddonPackage {
  id            String   @id @default(uuid())
  code          String   @unique // E.g., "AI_TOKENS_1M", "AI_TOKENS_5M"
  name          String
  description   String?
  credits       BigInt   // Number of credits provided
  pricePkr      Int      // Local retail price in Pakistani Rupees
  priceUsd      Decimal  @db.Decimal(10, 4) // Equivalent USD price for reporting
  validityDays  Int      @default(0) // 0 = non-expiring
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases     AICreditPurchaseRequest[]

  @@index([isActive, sortOrder])
}

model AICreditPurchaseRequest {
  id                   String    @id @default(uuid())
  collegeId            String
  packageId            String
  credits              BigInt
  amountPkr            Int
  paymentMethod        String    // BANK_TRANSFER, EASYPAISA, JAZZCASH, STRIPE
  transactionReference String?
  evidenceUrl          String?   // R2 URL to bank slip or receipt
  paymentStatus        String    @default("SUBMITTED") // SUBMITTED, VERIFIED, REJECTED
  approvalStatus       String    @default("PENDING")   // PENDING, APPROVED, REJECTED, REFUNDED
  verifiedByUserId     String?
  verifiedAt           DateTime?
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectionReason      String?
  grantId              String?   @unique
  receiptNumber        String?   // Mapped to Academix RCP-YYYY-XXXXX
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  package              AIAddonPackage @relation(fields: [packageId], references: [id])

  @@index([collegeId, approvalStatus])
  @@index([paymentStatus, approvalStatus])
}

// -----------------------------------------------------------------------------
// 3. Provider Credentials & Model Management
// -----------------------------------------------------------------------------

model ProviderCredential {
  id                     String    @id @default(uuid())
  provider               String    // gemini, openai, openrouter, deepseek
  encryptedKey           String
  iv                     String
  authTag                String
  keyHint                String    // Last 4 characters for identification
  isActive               Boolean   @default(true)
  isPrimary              Boolean   @default(false)
  spendingLimitMonthlyUsd Decimal? @db.Decimal(10, 2)
  currentMonthlySpendUsd  Decimal  @default(0) @db.Decimal(10, 2)
  lastTestedAt           DateTime?
  lastTestStatus         String?   // SUCCESS, FAILED
  lastError              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([provider, isActive])
}

model ModelDefinition {
  id               String   @id @default(uuid())
  modelKey         String   @unique // E.g., "gemini-2.0-flash", "gpt-4o-mini"
  provider         String   // gemini, openai, openrouter
  name             String
  capabilities     String[] // chat, stream, vision, embeddings, json
  contextWindow    Int      // Maximum tokens
  maxOutputTokens  Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pricingHistory   AIModelPricing[]

  @@index([provider, isActive])
}

model AIModelPricing {
  id                          String    @id @default(uuid())
  modelKey                    String
  version                     Int       @default(1)
  inputPricePerMillionUsd     Decimal   @db.Decimal(12, 6)
  outputPricePerMillionUsd    Decimal   @db.Decimal(12, 6)
  cachedInputPricePerMillionUsd Decimal @default(0) @db.Decimal(12, 6)
  effectiveFrom               DateTime  @default(now())
  effectiveTo                 DateTime?
  createdAt                   DateTime  @default(now())

  model                       ModelDefinition @relation(fields: [modelKey], references: [modelKey])

  @@unique([modelKey, version])
  @@index([modelKey, effectiveFrom])
}

model FeatureRouteRule {
  id               String   @id @default(uuid())
  featureKey       String   @unique // E.g., "ai-chat", "student-tutor", "quiz-generator", "pdf-rag"
  primaryModelKey  String
  fallbackModelKey String?
  timeoutMs        Int      @default(30000)
  maxTokens        Int      @default(2048)
  temperature      Float    @default(0.7)
  isStreaming      Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 4. Document Intelligence, RAG & Vector Embeddings
// -----------------------------------------------------------------------------

model DocumentKnowledgeBase {
  id               String   @id @default(uuid())
  collegeId        String
  title            String
  subject          String?
  department       String?
  academicYear     String?
  r2Key            String
  fileSizeBytes    Int
  pageCount        Int      @default(0)
  status           String   @default("PENDING") // PENDING, PROCESSING, INDEXED, FAILED
  errorMessage     String?
  uploadedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chunks           DocumentChunk[]

  @@index([collegeId, status])
  @@index([collegeId, subject])
}

model DocumentChunk {
  id           String   @id @default(uuid())
  documentId   String
  collegeId    String
  chunkIndex   Int
  text         String   @db.Text
  tokenCount   Int
  pageNumber   Int?
  // Note: pgvector vector column is added via SQL migration:
  // embedding vector(768)
  createdAt    DateTime @default(now())

  document     DocumentKnowledgeBase @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@index([collegeId])
}

// -----------------------------------------------------------------------------
// 5. Telemetry, Audit & Global Controls
// -----------------------------------------------------------------------------

model AIRequestLog {
  id                 String   @id @default(uuid())
  requestId          String   @unique
  collegeId          String
  userId             String
  role               String
  featureKey         String
  provider           String
  modelKey           String
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  totalTokens        Int      @default(0)
  providerCostMicros BigInt   @default(0) // Micro-USD ($0.000001)
  creditsDebited     BigInt   @default(0)
  durationMs         Int      @default(0)
  status             String   // SUCCESS, FAILED, TIMEOUT, CLIENT_DISCONNECT
  errorMessage       String?
  createdAt          DateTime @default(now())

  @@index([collegeId, createdAt])
  @@index([userId, createdAt])
  @@index([featureKey, createdAt])
  @@index([status, createdAt])
}

model GlobalAISetting {
  key              String   @id
  value            Json
  updatedByUserId  String?
  updatedAt        DateTime @updatedAt
}

