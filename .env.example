# ==============================================================================
# Collegeshub AI Microservice — Environment Configuration Template
# All secrets and credentials MUST be configured in deployment environment.
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Server Runtime
NODE_ENV=
PORT=
LOG_LEVEL=

# Internal Server-to-Server Authentication (Between Main Backend & AI Backend)
INTERNAL_SERVICE_SECRET=
INTERNAL_SERVICE_ISSUER=
INTERNAL_SERVICE_AUDIENCE=

# Master Credential Encryption Key (32-byte hex for AES-256-GCM provider key vault)
MASTER_ENCRYPTION_KEY=

# Neon PostgreSQL Database (Dedicated AI Service Database with pgvector)
AI_DATABASE_URL=
AI_DATABASE_DIRECT_URL=
DB_POOL_MAX=

# Redis & BullMQ Configuration (Queues, rate limiting, and ephemeral nonce cache)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Cloudflare R2 Document Storage (Academic PDFs and extracted assets)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=

# Global Cost & Safety Caps
GLOBAL_DAILY_BUDGET_USD=
GLOBAL_MONTHLY_BUDGET_USD=
KILL_SWITCH_ACTIVE=

